{
  "$schema": "./gen/schemas/desktop-schema.json",
  "identifier": "loopback-host",
  "description": "Main window loading the host's authenticated loopback origin (http://127.0.0.1:19387) — official-carrier model. Remote contexts need every app command listed explicitly (Tauri v2 ACL).",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1",
      "http://127.0.0.1:19387",
      "http://localhost",
      "http://localhost:19387"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "window-state:default",
    "allow-bridge-fetch",
    "allow-bridge-fetch-abort",
    "allow-bridge-log",
    "allow-bridge-probe",
    "allow-bridge-ws-close",
    "allow-bridge-ws-open",
    "allow-bridge-ws-send",
    "allow-shell-diagnostics",
    "allow-shell-dispatch-shortcut",
    "allow-shell-get-close-behavior",
    "allow-shell-get-keybindings",
    "allow-shell-get-notify-prefs",
    "allow-shell-hot-restart",
    "allow-shell-open-external",
    "allow-shell-reset-runtime",
    "allow-shell-restore-keybindings",
    "allow-shell-retry-startup",
    "allow-shell-set-close-behavior",
    "allow-shell-set-keybindings",
    "allow-shell-set-notify-prefs",
    "allow-shell-show-window",
    "allow-shell-startup-status",
    "allow-shell-toggle-maximize",
    "allow-shell-window-geometry",
    "allow-shell-window-move",
    "allow-shell-window-resize",
    "allow-shell-app-update",
    "allow-shell-check-app-update",
    "allow-shell-check-update",
    "allow-shell-dsh-update",
    "allow-welcome-complete",
    "allow-welcome-get-state",
    "allow-welcome-save-api-key"
  ]
}
